Task:
You are given an array of integers arr[]. You have to reverse the given array.

Solution Code:

class Solution {
  public:
    void reverseArray(vector<int> &arr) {
        // code here
        int n = arr.size();
        int first = 0;
        int last = n-1;
                while(first<last){
                    swap(arr[first], arr[last]);
                    first++;
                    last--;
                }
    }
};
