Task:
Given an array arr[]. Your task is to find the minimum and maximum elements in the array.

Solution Code:

class Solution {
  public:
    vector<int> getMinMax(vector<int> &arr) {
        // code here
        int max= arr[0];
        int min = arr[0];
        for(int i=0; i<arr.size(); i++){
            if(arr[i] > max){
                max = arr[i];
            }
            else if(arr[i]<min){
                min = arr[i];
            }
        }
        return {min, max};
    }
};
